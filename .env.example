# ── Supabase ──────────────────────────────────────────────────────
# URL do projeto (ex: https://<project-ref>.supabase.co)
SUPABASE_URL=
# Anon/public key (Settings → API → Project API keys)
SUPABASE_PUBLISHABLE_KEY=
# Senha do banco PostgreSQL (Settings → Database → Database password)
SUPABASE_PWD=

# ── MongoDB Atlas ─────────────────────────────────────────────────
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
MONGODB_CONN=
